{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ResizeManagedNodeGroup",
      "Effect": "Allow",
      "Action": [
        "eks:UpdateNodegroupConfig",
        "eks:DescribeNodegroup"
      ],
      "Resource": "arn:aws:eks:us-west-1:195675606509:nodegroup/eks-lab/ng-eks/*"
    },
    {
      "Sid": "ReadCluster",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster"
      ],
      "Resource": "arn:aws:eks:us-west-1:195675606509:cluster/eks-lab"
    },
    {
      "Sid": "ObserveAutoScalingGroup",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeAutoScalingGroups",
        "autoscaling:DescribeInstanceRefreshes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WriteSchedulerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-west-1:195675606509:log-group:/aws/lambda/eks-node-scheduler:*"
    }
  ]
}