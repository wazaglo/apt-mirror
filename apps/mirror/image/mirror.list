#### Debian 12 bookworm amd64, served from EFS ####
# base_path must match the PVC mount point in the CronJob
# (apps/mirror/cronjob-debian12-sync.yaml mounts at /var/spool/apt-mirror).
set base_path    /var/spool/apt-mirror
set mirror_path  $base_path/mirror
set skel_path    $base_path/skel
set var_path     $base_path/var
set cleanscript $var_path/clean.sh
set defaultarch  amd64
set postmirror_script $base_path/var/postmirror.sh
set run_postmirror 1
set nthreads     10
set _tilde       0
set use_proxy    0

# bookworm-security is a SEPARATE archive rooted at /debian-security. It is not
# under /debian — pointing a dist at deb.debian.org/debian for security is a 404
# and aborts the whole sync. This is the exact bug debmirror's single
# --root=/debian config hit.
deb-amd64 https://deb.debian.org/debian bookworm main contrib non-free non-free-firmware
deb-amd64 https://deb.debian.org/debian bookworm-updates main contrib non-free non-free-firmware
deb-amd64 https://security.debian.org/debian-security bookworm-security main contrib non-free non-free-firmware

clean https://deb.debian.org/debian
clean https://security.debian.org/debian-security
